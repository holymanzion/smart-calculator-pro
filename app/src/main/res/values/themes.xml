<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints the whole UI; this base theme only needs to be a
         no-action-bar shell with a background that matches the light scheme so
         there is no flash before the first frame. -->
    <style name="Theme.Calculator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
